PORT=4021
NODE_ENV=development
# Qie Mainnet by default
NETWORK=mainnet
DATABASE_URL=postgresql://tremor:tremor@localhost:5436/tremor
REDIS_URL=redis://localhost:6380
# No public x402 facilitator supports Qie today (GoPlausible is Algorand/Base/Solana
# only) — leave unset in dev, or point at a self-hosted facilitator for eip155:1990/1983.
X402_FACILITATOR_URL=
PAYTO_ADDRESS=0x0000000000000000000000000000000000000000
# Required — no fallback. Gates all /internal/* routes (dashboard revenue,
# payer addresses, risk data). A missing value fails startup instead of
# silently defaulting to a guessable string.
INTERNAL_API_KEY=change-me-to-a-long-random-secret
# Live Qie Mainnet indexing (set true only for offline seed demo)
USE_MOCK_DATA=false
QIE_RPC_URL=https://rpc1mainnet.qie.digital
QIE_EXPLORER_URL=https://mainnet.qie.digital
QIE_SUBGRAPH_URL=https://graphql.qie.digital/subgraphs/name/qie-dex/dex
# Testnet-only subgraph override (mainnet subgraph URL above is used when NETWORK=mainnet)
QIE_TESTNET_SUBGRAPH=
QIE_WQIE=0x0087904D95BEe9E5F24dc8852804b547981A9139
# Overrides the x402 discovery tag (defaults to "tremor-qie")
X402_TAG=
# Set to "false" to skip syncing supported payment kinds from the facilitator on boot
X402_SYNC_ON_START=
# ERC-20 contract address to accept x402 payment in (e.g. USDC on Qie) — no default,
# must be set to a real deployed token contract before payments can settle.
QIE_PAYMENT_ASSET_ADDRESS=
QIE_PAYMENT_ASSET_SYMBOL=USDC
QIE_PAYMENT_ASSET_DECIMALS=6
